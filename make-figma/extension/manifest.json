{
  "manifest_version": 3,
  "name": "Make → SAP (standalone)",
  "version": "2.0.0",
  "description": "Read a running Figma Make app for the SAP Bridge Figma plugin. Click once, or paste a Make link in the plugin.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Make → SAP: copy this app"
  }
}