  "image_labels": {
    "_doc": "GATE 0. measure-ref.py guess label (matched by PREFIX, longest first) + a size rule -> ONE kit component or a container frame. Sizes in build px. Covers every label guess() can return (checked 2026-09-26). A label not here -> unmapped (shown in the plan, never a silent guess). Also read by audit-screen.py role(). audit_role = the coarse family audit-screen.py compares by (same families as its old _KIND_ALIAS, so scores do not change); a rule without audit_role compares by its own label.",
    "rules": [
      {
        "label": "Field with label",
        "size": [
          {
            "else": "Form Item"
          }
        ],
        "audit_role": "field"
      },
      {
        "label": "Input / Select",
        "size": [
          {
            "else": "candidates",
            "options": [
              "Input",
              "Select"
            ]
          }
        ],
        "audit_role": "field"
      },
      {
        "label": "Input / Button (outline)",
        "size": [
          {
            "w_max": 48,
            "component": "Icon Button"
          },
          {
            "w_max": 120,
            "component": "Button"
          },
          {
            "else": "Input"
          }
        ],
        "audit_role": "field"
      },
      {
        "label": "Tile / chip — SELECTED",
        "size": [
          {
            "h_max": 26,
            "component": "Tag",
            "state": "on"
          },
          {
            "else": "container",
            "state": "on"
          }
        ],
        "audit_role": "tile"
      },
      {
        "label": "Tile / chip",
        "size": [
          {
            "h_max": 26,
            "component": "Tag"
          },
          {
            "else": "container"
          }
        ],
        "audit_role": "tile"
      },
      {
        "label": "Check Box",
        "size": [
          {
            "h_max": 19,
            "component": "Check Box",
            "density": "Compact"
          },
          {
            "else": "Check Box",
            "density": "Cozy"
          }
        ]
      },
      {
        "label": "Switch track",
        "size": [
          {
            "else": "Switch"
          }
        ]
      },
      {
        "label": "Button Primary",
        "size": [
          {
            "h_max": 31,
            "component": "Button",
            "props": {
              "Type": "Primary"
            },
            "density": "Compact"
          },
          {
            "else": "Button",
            "props": {
              "Type": "Primary"
            },
            "density": "Cozy"
          }
        ],
        "audit_role": "button"
      },
      {
        "label": "Avatar / icon circle",
        "size": [
          {
            "else": "Avatar"
          }
        ]
      },
      {
        "label": "Card / list item",
        "size": [
          {
            "else": "container"
          }
        ],
        "audit_role": "card"
      },
      {
        "label": "filled panel / selected item",
        "size": [
          {
            "else": "container",
            "state": "on"
          }
        ],
        "audit_role": "tile"
      },
      {
        "label": "dot",
        "size": [
          {
            "else": "decoration"
          }
        ]
      },
      {
        "label": "box",
        "size": [
          {
            "else": "unmapped"
          }
        ]
      }
    ],
    "container": {
      "_doc": "container = a plain unstyled auto-layout FRAME, no fill, only a border token if the label had a visible edge.",
      "border_token": "sapList_BorderColor",
      "selected_border_token": "sapList_SelectionBorderColor"
    }
  },
