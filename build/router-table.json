      "text": "text only",
      "style": "text style (kit.json text)",
      "role": "colour_roles or component_roles key",
      "token": "SAP token allowed for role (optional = role default)",
      "component": "kit component",
      "props": "{prop:value} real options",
      "icon": "icon name",
      "meaning": "icon meaning (icon_meanings key)",
